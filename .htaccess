RewriteEngine On

# If the request is for an existing file/folder INSIDE the "public" folder, serve it directly
RewriteCond %{REQUEST_URI} !^/public/
RewriteCond %{DOCUMENT_ROOT}/public/%{REQUEST_URI} -f [OR]
RewriteCond %{DOCUMENT_ROOT}/public/%{REQUEST_URI} -d
RewriteRule ^(.*)$ public/$1 [L]

# Route all other requests through public/index.php (Laravel's entry point)
RewriteRule ^(.*)$ public/index.php [L]

# BLOCK access to sensitive folders and files (SECURITY)
RewriteRule ^(app|config|database|storage|vendor|bootstrap|\.env|\.git) - [F,L]
