<script>
(function () {
    'use strict';

    /* ============================================================
       TAB SWITCHING
       ============================================================ */
    function activateTab(name) {
        document.querySelectorAll('.settings-tabs .tab').forEach(function (a) {
            a.classList.toggle('active', a.dataset.tab === name);
        });
        document.querySelectorAll('.tab-panel').forEach(function (p) {
            p.style.display = (p.dataset.panel === name) ? 'block' : 'none';
        });
    }

    function currentTab() {
        var hash    = window.location.hash.replace('#', '');
        var fromUrl = new URLSearchParams(window.location.search).get('tab');
        return hash || fromUrl || 'statuses';
    }

    document.querySelectorAll('.settings-tabs .tab').forEach(function (a) {
        a.addEventListener('click', function (e) {
            e.preventDefault();
            history.replaceState(null, '', '#'.concat(a.dataset.tab));
            activateTab(a.dataset.tab);
        });
    });

    window.addEventListener('hashchange', function () {
        activateTab(currentTab());
    });

    activateTab(currentTab());

    /* ============================================================
       FACEBOOK FORM → PROJECT MAPPING (searchable picker)
       ============================================================ */
    (function initFbProjectPickers() {
        var jsonEl = document.getElementById('fb-projects-json');
        if (! jsonEl) return;

        var PROJECTS = [];
        try {
            PROJECTS = JSON.parse(jsonEl.dataset.projects || '[]');
        } catch (e) {
            console.error('Bad projects JSON', e);
            return;
        }

        var MAX_RESULTS = 60;

        function renderResults(resultsEl, query) {
            var q = (query || '').toLowerCase().trim();
            var matches = [];

            for (var i = 0; i < PROJECTS.length; i++) {
                if (! q || PROJECTS[i].name.toLowerCase().indexOf(q) !== -1) {
                    matches.push(PROJECTS[i]);
                    if (matches.length >= MAX_RESULTS) break;
                }
            }

            resultsEl.innerHTML = '';

            if (matches.length === 0) {
                var empty = document.createElement('div');
                empty.className = 'op-empty';
                empty.textContent = 'No matching project';
                resultsEl.appendChild(empty);
                resultsEl.hidden = false;
                return;
            }

            var totalLabel = document.createElement('div');
            totalLabel.className = 'op-group-label';
            totalLabel.textContent = q
                ? 'Top ' + matches.length + ' matches'
                : PROJECTS.length + ' projects — type to filter';
            resultsEl.appendChild(totalLabel);

            matches.forEach(function (p) {
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'proj-item';
                btn.dataset.projectId   = p.id;
                btn.dataset.projectName = p.name;
                btn.innerHTML = '<span class="proj-item-name">' + p.name + '</span>';
                resultsEl.appendChild(btn);
            });

            resultsEl.hidden = false;
        }

        function saveMapping(formId, projectId, inputEl, clearBtn) {
            inputEl.disabled = true;
            inputEl.style.background = '#fff8e6';

            fetch('{{ url('/settings/facebook-leads/map') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': '{{ csrf_token() }}',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ form_id: formId, project_id: projectId })
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.ok) {
                    inputEl.style.background = '#e8f8ef';
                    setTimeout(function () { inputEl.style.background = ''; }, 900);
                    clearBtn.hidden = ! projectId;
                } else {
                    inputEl.style.background = '#ffe5e5';
                    alert('Save failed: ' + (data.error || 'unknown'));
                    setTimeout(function () { inputEl.style.background = ''; }, 2000);
                }
            })
            .catch(function (err) {
                inputEl.style.background = '#ffe5e5';
                alert('Save failed: ' + err.message);
            })
            .finally(function () {
                inputEl.disabled = false;
            });
        }

        document.querySelectorAll('.fb-proj-picker').forEach(function (picker) {
            var input    = picker.querySelector('.fb-proj-search');
            var results  = picker.querySelector('.fb-proj-results');
            var clearBtn = picker.querySelector('.fb-proj-clear');
            var formId   = picker.dataset.formId;

            if (! input || ! results) return;

            input.addEventListener('focus', function () {
                input.removeAttribute('readonly');
                input.select();
                renderResults(results, '');
            });

            input.addEventListener('input', function () {
                renderResults(results, input.value);
                clearBtn.hidden = ! input.value;
            });

            input.addEventListener('blur', function () {
                setTimeout(function () {
                    input.setAttribute('readonly', 'readonly');
                    var savedId = input.dataset.projectId;
                    if (savedId) {
                        var saved = null;
                        for (var i = 0; i < PROJECTS.length; i++) {
                            if (String(PROJECTS[i].id) === String(savedId)) { saved = PROJECTS[i]; break; }
                        }
                        if (saved) input.value = saved.name;
                    }
                    results.hidden = true;
                }, 200);
            });

            input.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    results.hidden = true;
                    input.blur();
                }
            });

            results.addEventListener('click', function (e) {
                var item = e.target.closest('.proj-item');
                if (! item) return;

                var pid  = item.dataset.projectId;
                var name = item.dataset.projectName;

                input.value = name;
                input.dataset.projectId = pid;
                clearBtn.hidden = false;
                results.hidden = true;

                saveMapping(formId, pid, input, clearBtn);
            });

            if (clearBtn) {
                clearBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    input.value = '';
                    input.dataset.projectId = '';
                    clearBtn.hidden = true;
                    results.hidden = true;
                    saveMapping(formId, '', input, clearBtn);
                });
            }

            document.addEventListener('click', function (e) {
                if (! picker.contains(e.target)) results.hidden = true;
            });
        });
    })();
        /* ============================================================
       FORM LIST FILTER — page-first, then search + min-leads
       ============================================================ */
    (function initFormFilter() {
        var pageSelector = document.getElementById('fb-page-selector');
        var searchBox    = document.getElementById('fb-forms-search');
        var minLeadsIn   = document.getElementById('fb-forms-min-leads');
        var counter      = document.getElementById('fb-forms-count');
        var rows         = document.querySelectorAll('#fb-forms-table .fb-form-row');
        var prompt       = document.getElementById('fb-no-page-prompt');
        var wrapper      = document.getElementById('fb-forms-wrapper');
        var emptyState   = document.getElementById('fb-forms-empty-state');

        if (! pageSelector || ! rows.length) return;

        function applyFilter() {
            var selectedPage = pageSelector.value || '';

            if (! selectedPage) {
                if (prompt)  prompt.style.display  = 'block';
                if (wrapper) wrapper.style.display = 'none';
                return;
            }

            if (prompt)  prompt.style.display  = 'none';
            if (wrapper) wrapper.style.display = 'block';

            var q           = (searchBox.value || '').toLowerCase().trim();
            var minLeadsVal = parseInt(minLeadsIn.value || '0', 10);
            if (isNaN(minLeadsVal)) minLeadsVal = 0;

            var visible   = 0;
            var pageTotal = 0;

            rows.forEach(function (row) {
                var rowPageId = row.dataset.pageId || '';

                if (rowPageId !== selectedPage) {
                    row.style.display = 'none';
                    return;
                }

                pageTotal++;

                var name   = row.dataset.formName    || '';
                var leads  = parseInt(row.dataset.leadsCount || '0', 10);
                var status = (row.dataset.formStatus || '').toUpperCase();

                var isActive    = status === 'ACTIVE';
                var matchSearch = ! q || name.indexOf(q) !== -1;
                var matchLeads  = leads >= minLeadsVal;
                var show        = isActive && matchSearch && matchLeads;

                row.style.display = show ? '' : 'none';
                if (show) visible++;
            });

            if (counter) {
                counter.textContent = visible + ' of ' + pageTotal + ' forms';
            }

            if (emptyState) {
                emptyState.style.display = visible === 0 ? 'block' : 'none';
            }
        }

        pageSelector.addEventListener('change', applyFilter);
        searchBox.addEventListener('input', applyFilter);
        minLeadsIn.addEventListener('input', applyFilter);

        applyFilter();
    })();
})();
</script>
